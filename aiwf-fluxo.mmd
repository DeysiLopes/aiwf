flowchart TD
  subgraph CLI["aiwf CLI"]
    init["init"] --> create["create &lt;id&gt;"]
    create --> run["run / resume &lt;id&gt;"]
  end

  subgraph INIT[". &#10;  init"]
    AGENTS[".agents/"]
    SKILLS[".agents/skills/&#10;  18 skills .md"]
    EXAMPLE[".agents/workflows/EXAMPLE-001/&#10;  workflow.yaml"]
    ARTIFACTS[".agents/artifacts/&#10;  (vazio)"]
    AGENTS --> SKILLS
    AGENTS --> EXAMPLE
    AGENTS --> ARTIFACTS
  end

  subgraph CREATE[". &#10;  create"]
    LLM_CMD["LLM + skill&#10;generate-workflow.md"]
    GENERATED[".agents/workflows/&lt;id&gt;/&#10;  workflow.yaml"]
    LLM_CMD --> GENERATED
  end

  subgraph ENGINE[". &#10;  engine pipeline"]
    PB["prompt-builder"]
    SP["sdd-specify"]
    CL["sdd-clarify"]
    PL["sdd-plan"]
    TK["sdd-tasks"]
    IM["sdd-implement"]
    TE["sdd-teste"]
    CR["code-reviewr"]
    CLO["sdd-closer"]
    PB --> SP --> CL --> PL --> TK --> IM --> TE --> CR --> CLO
  end

  subgraph GIT["git ci/cd"]
    F["feature/*"]
    DEV["develop"]
    REL["release/v0.x.x"]
    MAIN["main"]
    NPM["npm publish"]
    F -->|auto pr| DEV
    DEV -->|promote + tag| REL
    REL -->|auto pr| MAIN
    MAIN -->|tag v*| NPM
  end

  init -.->|prep| create
  create -.->|cria yaml| run
  run --> ENGINE
  ENGINE -.->|commita code| GIT
